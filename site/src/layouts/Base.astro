---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/azeret-mono';
import '../styles/global.css';
import groteskFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/azeret-mono/files/azeret-mono-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  current?: string;
  overlay?: boolean;
  data?: string;
}

const { title, description, current = '', overlay = false, data } = Astro.props;
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : `${raw}/`;
const links = [
  { slug: 'yard', label: 'Yard' },
  { slug: 'plan', label: 'Plan' },
  { slug: 'district', label: 'District' },
  { slug: 'sources', label: 'Sources' },
];
const fullTitle = title === 'Shady' ? 'Shady' : `${title} | Shady`;
const home = Astro.site ?? Astro.url;
const share = new URL(`${base}og.png?v=3`, home).href;
const address = new URL(Astro.url.pathname, home).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9eff1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={address} />
    <meta property="og:image" content={share} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share} />
    <link rel="preload" href={groteskFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    {data && <link rel="preload" href={data} as="fetch" crossorigin />}
    <link rel="canonical" href={address} />
    <link rel="icon" href={`${base}favicon.svg?v=1`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.png?v=1`} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png?v=1`} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={['shell flex h-[72px] items-center justify-between gap-4', overlay && 'topbar']}>
      <a class="wordmark markchip" href={base} aria-label="Shady home">shady</a>
      <nav aria-label="Main">
        <ul class="navpill">
          {
            links.map((link) => (
              <li>
                <a href={`${base}${link.slug}/`} aria-current={current === link.slug ? 'page' : undefined} class="max-[479px]:px-[7px] max-[479px]:text-[0.875rem] max-[389px]:px-[5px] max-[389px]:text-[0.8125rem]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
