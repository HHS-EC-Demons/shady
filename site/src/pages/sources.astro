---
import Base from '../layouts/Base.astro';
import { sources as all } from '../lib/sources';
---

<Base title="Sources" description="Every number in Shady and where it comes from." current="sources">
  <div class="shell mx-auto flex max-w-[1180px] flex-col gap-10 pb-20 pt-6">
    <h1 class="text-[clamp(2.25rem,4.4vw,3.75rem)]">Sources</h1>
    <ul class="m-0 list-none p-0">
      {
        all.map((row) => (
          <li class="grid grid-cols-1 gap-x-8 gap-y-1 border-t border-rule py-3.5 md:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,6fr)]">
            <span class="font-medium">{row.what}</span>
            <span class="data">{row.value}</span>
            {row.url ? (
              <a href={row.url} class="inline-flex min-h-11 items-center text-soft underline underline-offset-4 hover:text-oak" rel="noreferrer">
                {row.source}
              </a>
            ) : (
              <span class="text-soft">{row.source}</span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="text-lg">Shady models ground temperature. Ground temperature does not predict heat illness.</p>
  </div>
</Base>
