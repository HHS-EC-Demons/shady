---
import Base from '../layouts/Base.astro';

const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : `${raw}/`;
---

<Base title="Page not found" description="This page does not exist.">
  <div class="shell mx-auto flex max-w-[1180px] flex-col gap-6 pb-20 pt-6">
    <h1 class="text-[clamp(2.25rem,4.4vw,3.75rem)]">Nothing here</h1>
    <a href={`${base}yard`} class="pill">Open the yard</a>
  </div>
</Base>
